PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Configuración de base de datos PostgreSQL
PGUSER=postgres
PGHOST=localhost
PGDATABASE=bikerstock3d
PGPASSWORD=replace-with-your-local-postgres-password
PGPORT=5432

# Alternativa con URL de conexión completa:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bikerstock3d
