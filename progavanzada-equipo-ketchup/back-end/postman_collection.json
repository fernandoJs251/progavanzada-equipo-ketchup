        {
          "name": "Crear Casco (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Arai RX-7V Racing\",\n  \"marca\": \"Arai\",\n  \"categoria\": \"Integral\",\n  \"precio\": 4500,\n  \"precioAnterior\": 4900,\n  \"stock\": 6,\n  \"stockMinimo\": 2,\n  \"talla\": \"L\",\n  \"tallasDisponibles\": [\"M\", \"L\", \"XL\"],\n  \"color\": \"Blanco / Azul / Rojo\",\n  \"coloresDisponibles\": [\"Blanco / Azul / Rojo\", \"Negro Carbono\"],\n  \"imagen\": \"https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800&auto=format&fit=crop&q=80\",\n  \"imagenes\": [\n    \"https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800&auto=format&fit=crop&q=80\"\n  ],\n  \"descripcion\": \"Casco tope de gama para competición MotoGP de la legendaria marca japonesa Arai.\",\n  \"caracteristicas\": [\n    \"Fibra de carbono PB-SNC2\",\n    \"Alerón aerodinámico DF-X2\",\n    \"Homologación FIM Racing y ECE 22.06\"\n  ],\n  \"homologacion\": \"ECE 22.06 / FIM\",\n  \"peso\": \"1380g\",\n  \"destacado\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cascos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cascos"]
            }
          },
          "response": []
        },
