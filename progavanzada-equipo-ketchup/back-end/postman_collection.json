                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Rodrigo Castro\",\n  \"email\": \"rodrigo.castro@gmail.com\",\n  \"password\": \"segura123\",\n  \"telefono\": \"+591 78912345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Perfil Actual (Requiere Token)",
          "request": {
            "method": "GET",
            "header": [
