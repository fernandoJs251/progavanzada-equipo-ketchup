            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 780,\n  \"stock\": 9,\n  \"descripcion\": \"Casco integral optimizado con nueva pantalla Pinlock MaxVision 70.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cascos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cascos", "1"]
            }
