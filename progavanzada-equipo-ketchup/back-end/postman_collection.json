    {
      "name": "4. Pedidos y Carrito (Checkout)",
      "item": [
        {
          "name": "Listar Todos los Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            }
          },
          "response": []
        },
        {
          "name": "Crear Pedido (Checkout con Descuento de Stock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Pedido contiene número con prefijo BKS-2026', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.numeroPedido).to.include('BKS-2026-');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": {\n    \"nombre\": \"Mateo\",\n    \"apellido\": \"Villanueva\",\n    \"ci\": \"7492014\",\n    \"telefono\": \"+591 76598741\",\n    \"correo\": \"mateo.villanueva@gmail.com\",\n    \"direccion\": \"Calle Sagárnaga #240\",\n    \"ciudad\": \"La Paz\",\n    \"notas\": \"Llamar antes de entregar\"\n  },\n  \"items\": [\n    {\n      \"helmet\": {\n        \"id\": 1,\n        \"nombre\": \"LS2 Stream Evo\",\n        \"marca\": \"LS2\",\n        \"precio\": 750,\n        \"imagen\": \"https://images.unsplash.com/photo-1558981806-ec527fa84c39?w=800&auto=format&fit=crop&q=80\"\n      },\n      \"cantidad\": 1,\n      \"tallaSeleccionada\": \"M\",\n      \"colorSeleccionado\": \"Negro Mate\"\n    }\n  ],\n  \"subtotal\": 750,\n  \"envio\": 0,\n  \"total\": 750,\n  \"metodoPago\": \"QR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pedidos"]
            },
            "description": "Registra una compra. Descuenta de forma automática las unidades adquiridas del stock del casco en la base de datos."
          },
          "response": []
